    {
      "name": "LoginLogs",
      "description": "Run SQL/LoginLogs-table-creation.sql before testing. Run Users / Login seeded user first to capture the shared accessToken. Successful POST requests insert rows in dbo.LoginLogs and save the latest generated ID as loginLogId. LoginTime is sent without an offset and is interpreted in the API machine's local time zone.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const localTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000);",
              "pm.variables.set('loginLogTime', localTime.toISOString().slice(0, -1));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Create successful login log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const expected = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "pm.test('returns the generated LogId and all supplied fields', function () {",
                  "  pm.expect(json.logId).to.be.a('number').and.above(0);",
                  "  ['username', 'success', 'ipAddress', 'userAgent', 'errorMessage'].forEach(function (field) {",
                  "    pm.expect(json[field], field).to.eql(expected[field]);",
                  "  });",
                  "  pm.expect(Date.parse(json.loginTime)).to.eql(Date.parse(expected.loginTime));",
                  "});",
                  "pm.environment.set('loginLogId', String(json.logId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginLogUsername}}\",\n  \"loginTime\": \"{{loginLogTime}}\",\n  \"success\": true,\n  \"ipAddress\": \"127.0.0.1\",\n  \"userAgent\": \"PostmanRuntime/7.45.0\",\n  \"errorMessage\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{protocol}}://{{api_host}}:{{port}}/api/v1/loginlogs",
              "protocol": "{{protocol}}",
              "host": [
                "{{api_host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "v1",
                "loginlogs"
              ]
            }
          }
        },
        {
          "name": "Create failed login log with IPv6 address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const expected = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "pm.test('returns the generated LogId and all supplied fields', function () {",
                  "  pm.expect(json.logId).to.be.a('number').and.above(0);",
                  "  ['username', 'success', 'ipAddress', 'userAgent', 'errorMessage'].forEach(function (field) {",
                  "    pm.expect(json[field], field).to.eql(expected[field]);",
                  "  });",
                  "  pm.expect(Date.parse(json.loginTime)).to.eql(Date.parse(expected.loginTime));",
                  "});",
                  "pm.environment.set('loginLogId', String(json.logId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginLogUsername}}\",\n  \"loginTime\": \"{{loginLogTime}}\",\n  \"success\": false,\n  \"ipAddress\": \"2001:db8::1\",\n  \"userAgent\": \"PostmanRuntime/7.45.0\",\n  \"errorMessage\": \"Invalid username or password.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
