          "name": "Login seeded user",
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('returns token', function () {",
                  "  pm.expect(json.token.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.token.tokenType).to.eql('Bearer');",
                  "  pm.expect(json.userRole).to.eql(pm.environment.get('seedUserRole'));",
                  "  pm.expect(json).to.not.have.property('userRoleId');",
                  "  pm.expect(json).to.not.have.property('userPass');",
                  "});",
                  "",
                  "pm.environment.set('accessToken', json.token.accessToken);",
                  "pm.environment.set('tokenExpiresAtUtc', json.token.expiresAtUtc);"
                ]
              }
            }
          ],
